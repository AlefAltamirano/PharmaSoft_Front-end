{
  "info": {
    "name": "PharmaSoft Semana 14",
    "description": "Solo entorno de desarrollo. Completar contraseñas y IDs de fixtures activos; no exportar tokens. La venta válida modifica stock; la última petición la anula.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090/api/v1"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "vendedorPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "vendedorToken",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "ventaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"{{adminPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.collectionVariables.set('adminToken',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login vendedor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"vendedor\", \"password\": \"{{vendedorPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200)pm.collectionVariables.set('vendedorToken',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Productos página 20 — 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/productos?pagina=0&tamanio=20",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auditoría admin — 200",
